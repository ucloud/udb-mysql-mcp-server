# 必填：UCloud API 密钥（https://console.ucloud.cn/uapi/apikey）
UCLOUD_PUBLIC_KEY={Your PublicKey}
UCLOUD_PRIVATE_KEY={Your PrivateKey}

# 可选：默认项目 ID（org-xxx）
UCLOUD_PROJECT_ID={Your ProjectId}

# 可选：默认地域，未设置时为 cn-bj2
UCLOUD_REGION=cn-bj2

# 可选：readonly（默认）| readwrite | admin
UCLOUD_MODE=readonly

# 可选：SSE 端口，默认 9000（仅影响默认 Listen 为 127.0.0.1:<port>）
MCP_SERVER_SSE_PORT=9000

# 可选：完整监听地址。Docker 端口映射时需设为 0.0.0.0:9000，
# 且宿主机务必使用 -p 127.0.0.1:9000:9000（禁止 -p 9000:9000）
# UCLOUD_MCP_LISTEN=0.0.0.0:9000
